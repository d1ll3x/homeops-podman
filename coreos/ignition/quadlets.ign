{
  "ignition": {
    "version": "3.6.0"
  },
  "storage": {
    "files": [
      {
        "group": {
          "name": "core"
        },
        "path": "/var/home/core/.config/containers/systemd/iot.network",
        "user": {
          "name": "core"
        },
        "contents": {
          "compression": "",
          "source": "data:,%5BNetwork%5D%0ANetworkName%3Diot%0ALabel%3Dservice%3Dhome-automation%0A"
        },
        "mode": 420
      },
      {
        "group": {
          "name": "core"
        },
        "path": "/var/home/core/.config/containers/systemd/z2m.container",
        "user": {
          "name": "core"
        },
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 384
      }
    ]
  }
}
