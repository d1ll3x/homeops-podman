{
  "ignition": {
    "version": "3.6.0"
  },
  "storage": {
    "directories": [
      {
        "group": {
          "name": "core"
        },
        "path": "/var/home/core/.config",
        "user": {
          "name": "core"
        },
        "mode": 448
      },
      {
        "group": {
          "name": "core"
        },
        "path": "/var/home/core/.config/containers",
        "user": {
          "name": "core"
        },
        "mode": 448
      },
      {
        "group": {
          "name": "core"
        },
        "path": "/var/home/core/.config/containers/systemd",
        "user": {
          "name": "core"
        },
        "mode": 448
      },
      {
        "group": {
          "name": "core"
        },
        "path": "/var/home/core/.local",
        "user": {
          "name": "core"
        },
        "mode": 448
      },
      {
        "group": {
          "name": "core"
        },
        "path": "/var/home/core/.local/share",
        "user": {
          "name": "core"
        },
        "mode": 448
      },
      {
        "group": {
          "name": "core"
        },
        "path": "/var/home/core/.local/share/containers",
        "user": {
          "name": "core"
        },
        "mode": 448
      },
      {
        "group": {
          "name": "core"
        },
        "path": "/var/home/core/.local/share/containers/storage",
        "user": {
          "name": "core"
        },
        "mode": 448
      }
    ],
    "disks": [
      {
        "device": "/dev/sdb",
        "partitions": [
          {
            "label": "data",
            "number": 1
          }
        ],
        "wipeTable": false
      }
    ],
    "files": [
      {
        "path": "/var/lib/systemd/linger/core",
        "mode": 420
      }
    ],
    "filesystems": [
      {
        "device": "/dev/disk/by-partlabel/data",
        "format": "xfs",
        "path": "/var/home/core/.local/share/containers/storage"
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "# Generated by Butane\n[Unit]\nRequires=systemd-fsck@dev-disk-by\\x2dpartlabel-data.service\nAfter=systemd-fsck@dev-disk-by\\x2dpartlabel-data.service\n\n[Mount]\nWhere=/var/home/core/.local/share/containers/storage\nWhat=/dev/disk/by-partlabel/data\nType=xfs\n\n[Install]\nRequiredBy=local-fs.target",
        "enabled": true,
        "name": "var-home-core-.local-share-containers-storage.mount"
      }
    ]
  }
}
