variant: fcos
version: 1.7.0
storage:
  files:
      # Network Definitions
    - path: /var/home/core/.config/containers/systemd/iot.network
      mode: 0644
      user: { name: core }
      group: { name: core }
      contents:
        local: quadlets/networks/iot.network

      # Container Definitions
    - path: /var/home/core/.config/containers/systemd/z2m.container
      mode: 0600
      user: { name: core }
      group: { name: core }
      contents:
        local: quadlets/containers/z2m.container


