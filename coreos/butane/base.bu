variant: fcos
version: 1.7.0

# BYOP - Bring your own public key
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIlYo/25hiuBE/m1ja6RLEbGO3y9QVmjNCKNycLW85GV

storage:
  # Persistence for statefull applications
  disks:
    - device: /dev/sdb
      wipe_table: false
      partitions:
      - label: data
        number: 1
  filesystems:
    - path: /var/home/core/.local/share/containers/storage
      device: /dev/disk/by-partlabel/data
      format: xfs
      with_mount_unit: true

  # Directory layout for rootless podman
  directories:
    - path: /var/home/core/.config
      user: { name: core }
      group: { name: core }
      mode: 0700
    - path: /var/home/core/.config/containers
      user: { name: core }
      group: { name: core }
      mode: 0700
    - path: /var/home/core/.config/containers/systemd
      user: { name: core }
      group: { name: core }
      mode: 0700
  
  # Start rootless Quadlets on boot
  files:
    - path: /var/lib/systemd/linger/core
      mode: 0644

# Setup the qemu guest agent
systemd:
  units:
    - name: "install-qemu-guest-agent.service"
      enabled: true
      contents: |
        [Unit]
        Description=Ensure qemu-guest-agent is installed
        Wants=network-online.target
        After=network-online.target
        Before=zincati.service
        ConditionPathExists=!/var/lib/%N.stamp

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=rpm-ostree install --allow-inactive --assumeyes --reboot qemu-guest-agent
        ExecStart=/bin/touch /var/lib/%N.stamp

        [Install]
        WantedBy=multi-user.target
